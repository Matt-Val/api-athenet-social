# Plantilla para /opt/athenet/social.env en la EC2.
# Se pasa con docker --env-file: sin export, sin comillas envolventes.
SERVER_PORT=8085

DB_URL=jdbc:postgresql://athenet-db.clgzbclcgbne.us-east-1.rds.amazonaws.com:5432/social_db?sslmode=require&connectTimeout=10&socketTimeout=30
DB_USERNAME=social_user
DB_PASSWORD=REEMPLAZAR_PASSWORD_SOCIAL

COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/REEMPLAZAR_USER_POOL_ID
COGNITO_CLIENT_ID=REEMPLAZAR_APP_CLIENT_ID
COGNITO_USERINFO_URI=https://REEMPLAZAR_DOMINIO.auth.us-east-1.amazoncognito.com/oauth2/userInfo

CORS_PUBLIC_ORIGINS=https://REEMPLAZAR_FRONT
CORS_USER_ORIGINS=https://REEMPLAZAR_FRONT

JPA_SHOW_SQL=false
LOG_LEVEL_SOCIAL=INFO
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError
